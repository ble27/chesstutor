  "narrative": {
    "northStar": "The Quiet Review Workspace",
    "overview": "Chess Tutor uses the approved quiet charcoal Operate direction: a practical tool whose visual emphasis belongs to the chess position and the next useful action. The existing teal and cream board remains the recognizable center of the review.  Flat bordered surfaces, one sans family, and compact explanatory text support careful reading. Gold connects actions, keyboard focus, and the current move. This records the implemented interface, not release or accessibility gate status.",
    "keyCharacteristics": [
      "Charcoal surfaces with quiet dividers.",
      "Teal and cream chessboard with gold move emphasis.",
      "Consistent sans typography and tabular chess numbers.",
      "Flat controls with visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Board Identity Rule",
        "body": "Preserve teal and cream squares; use gold to identify selected moves and actions rather than recoloring the board.",
        "section": "colors"
      },
      {
        "name": "The One Voice Rule",
        "body": "Use the shared sans stack for interface text and reserve monospace for literal position notation.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and tone to separate tool surfaces; reserve inset emphasis for selected state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the teal and cream board with gold move emphasis.",
      "**Do** use the shared sans family stack and tabular numbers for chess data.",
      "**Do** keep controls at least 44px high and show a visible keyboard focus state.",
      "**Do** use local SVG icons with their text labels and retain asset licenses.",
      "**Do** preserve the desktop 60/40 review split and stack it below 1024px."
    ],
    "donts": [
      "**Don't** introduce decorative glyph icons or a competing display typeface.",
      "**Don't** turn individual library games into a grid of cards.",
      "**Don't** add ambient card shadows to the flat charcoal surfaces.",
      "**Don't** treat the named Inter family as an installed font guarantee."
    ]
  }
}
