{
  "components": {
    "schemas": {
      "ArchivesResponse": {
        "additionalProperties": false,
        "properties": {
          "fetched_at": {
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "months": {
            "items": {
              "type": "string"
            },
            "title": "Months",
            "type": "array"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "fetched_at",
          "stale",
          "username",
          "months"
        ],
        "title": "ArchivesResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After Seconds"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GameResponse": {
        "additionalProperties": false,
        "properties": {
          "game": {
            "$ref": "#/components/schemas/GameSummary"
          },
          "initial_fen": {
            "title": "Initial Fen",
            "type": "string"
          },
          "pgn_hash": {
            "title": "Pgn Hash",
            "type": "string"
          },
          "positions": {
            "items": {
              "$ref": "#/components/schemas/PositionResponse"
            },
            "title": "Positions",
            "type": "array"
          },
          "result": {
            "enum": [
              "1-0",
              "0-1",
              "1/2-1/2"
            ],
            "title": "Result",
            "type": "string"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "game",
          "version",
          "pgn_hash",
          "initial_fen",
          "result",
          "positions"
        ],
        "title": "GameResponse",
        "type": "object"
      },
      "GameSummary": {
        "additionalProperties": false,
        "properties": {
          "black": {
            "$ref": "#/components/schemas/Player"
          },
          "eligibility": {
            "enum": [
              "available",
              "unsupported_game",
              "unfinished_game",
              "invalid_data",
              "game_too_large"
            ],
            "title": "Eligibility",
            "type": "string"
          },
          "end_time": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "rules": {
            "title": "Rules",
            "type": "string"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "time_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Class"
          },
          "white": {
            "$ref": "#/components/schemas/Player"
          }
        },
        "required": [
          "id",
          "source_url",
          "white",
          "black",
          "end_time",
          "time_class",
          "rules",
          "eligibility"
        ],
        "title": "GameSummary",
        "type": "object"
      },
      "GamesResponse": {
        "additionalProperties": false,
        "properties": {
          "fetched_at": {
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "games": {
            "items": {
              "$ref": "#/components/schemas/GameSummary"
            },
            "title": "Games",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          }
        },
        "required": [
          "fetched_at",
          "stale",
          "games",
          "next_cursor"
        ],
        "title": "GamesResponse",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Player": {
        "additionalProperties": false,
        "properties": {
          "rating": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "result": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "username": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "Player",
        "type": "object"
      },
      "PositionResponse": {
        "additionalProperties": false,
        "properties": {
          "fen": {
            "title": "Fen",
            "type": "string"
          },
          "ply": {
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Ply",
            "type": "integer"
          },
          "san": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "San"
          },
          "uci": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uci"
          }
        },
        "required": [
          "ply",
          "fen",
          "san",
          "uci"
        ],
        "title": "PositionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Chess Tutor API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/games/{game_id}": {
      "get": {
        "operationId": "imported_game",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Game Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Game"
      }
    },
