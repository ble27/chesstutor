    "/api/v1/players/{username}/games": {
      "get": {
        "operationId": "player_games",
        "parameters": [
          {
            "in": "path",
            "name": "username",
            "required": true,
            "schema": {
              "title": "Username",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "year",
            "required": true,
            "schema": {
              "maximum": 2100,
              "minimum": 2007,
              "title": "Year",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "month",
            "required": true,
            "schema": {
              "maximum": 12,
              "minimum": 1,
              "title": "Month",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "color",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "white",
                    "black"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Color"
            }
          },
          {
            "in": "query",
            "name": "opponent",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 25,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Opponent"
            }
          },
          {
            "in": "query",
            "name": "time_class",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "bullet",
                    "blitz",
                    "rapid",
                    "daily"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Time Class"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
