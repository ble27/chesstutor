{
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "game_id": {
            "format": "uuid",
            "title": "Game Id",
            "type": "string"
          },
          "mode": {
            "enum": [
              "quick",
              "deep"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "game_id",
          "mode"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "AnalysisResponse": {
        "additionalProperties": false,
        "properties": {
          "attempts": {
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Attempts",
            "type": "integer"
          },
          "cached": {
            "title": "Cached",
            "type": "boolean"
          },
          "can_cancel": {
            "title": "Can Cancel",
            "type": "boolean"
          },
          "completed_plies": {
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Completed Plies",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "deadline_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline At"
          },
          "dispatch_pending": {
            "title": "Dispatch Pending",
            "type": "boolean"
          },
          "engine": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Engine",
            "type": "object"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/MoveEvidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "game_id": {
            "format": "uuid",
            "title": "Game Id",
            "type": "string"
          },
          "game_version": {
            "title": "Game Version",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "enum": [
              "quick",
              "deep"
            ],
            "title": "Mode",
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "cancel_requested",
              "cancelled",
              "completed",
              "failed"
            ],
            "title": "State",
            "type": "string"
          },
          "total_plies": {
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Total Plies",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "game_id",
          "game_version",
          "mode",
          "state",
          "completed_plies",
          "total_plies",
          "attempts",
          "created_at",
          "updated_at",
          "deadline_at",
          "error_code",
          "dispatch_pending",
          "cached",
          "can_cancel",
          "engine",
          "evidence"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "ArchivesResponse": {
        "additionalProperties": false,
        "properties": {
          "fetched_at": {
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "months": {
            "items": {
              "type": "string"
            },
            "title": "Months",
            "type": "array"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "fetched_at",
          "stale",
          "username",
          "months"
        ],
        "title": "ArchivesResponse",
        "type": "object"
      },
      "BrowserBatch": {
        "additionalProperties": false,
        "properties": {
          "game_version": {
            "minimum": 1.0,
            "title": "Game Version",
            "type": "integer"
          },
          "pgn_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Pgn Hash",
            "type": "string"
          },
          "positions": {
            "items": {
              "$ref": "#/components/schemas/BrowserPly"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Positions",
            "type": "array"
          }
        },
        "required": [
          "game_version",
          "pgn_hash",
          "positions"
        ],
        "title": "BrowserBatch",
        "type": "object"
      },
      "BrowserEvidence": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/MoveEvidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "trust": {
            "const": "client_unverified",
            "default": "client_unverified",
            "title": "Trust",
            "type": "string"
          }
        },
        "required": [
          "evidence"
        ],
        "title": "BrowserEvidence",
        "type": "object"
      },
      "BrowserLine": {
        "additionalProperties": false,
        "properties": {
          "bounded": {
            "title": "Bounded",
            "type": "boolean"
          },
          "depth": {
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Depth",
            "type": "integer"
          },
          "nodes": {
            "maximum": 1000000000.0,
            "minimum": 1.0,
            "title": "Nodes",
            "type": "integer"
          },
          "pv": {
            "items": {
              "maxLength": 5,
              "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$",
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "title": "Pv",
            "type": "array"
          },
          "score": {
            "$ref": "#/components/schemas/BrowserScore"
          },
          "time_ms": {
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Time Ms",
            "type": "integer"
          },
          "wdl": {
            "anyOf": [
              {
                "items": {
                  "maximum": 1000.0,
                  "minimum": 0.0,
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wdl"
          }
        },
        "required": [
          "score",
          "wdl",
          "depth",
          "nodes",
          "time_ms",
          "pv",
          "bounded"
        ],
        "title": "BrowserLine",
        "type": "object"
      },
      "BrowserPly": {
        "additionalProperties": false,
        "properties": {
          "best": {
            "$ref": "#/components/schemas/BrowserLine"
          },
          "played": {
            "$ref": "#/components/schemas/BrowserLine"
          },
          "ply": {
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Ply",
            "type": "integer"
          }
        },
        "required": [
          "ply",
          "best",
          "played"
        ],
        "title": "BrowserPly",
        "type": "object"
      },
      "BrowserScore": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "cp",
              "mate"
            ],
            "title": "Kind",
            "type": "string"
          },
          "value": {
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "Value",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "title": "BrowserScore",
        "type": "object"
      },
      "CentipawnScore": {
        "additionalProperties": false,
        "properties": {
          "centipawns": {
            "title": "Centipawns",
            "type": "integer"
          },
          "kind": {
            "const": "cp",
            "default": "cp",
            "title": "Kind",
            "type": "string"
          },
          "pov": {
            "enum": [
              "white",
              "black"
            ],
            "title": "Pov",
            "type": "string"
          }
        },
        "required": [
          "centipawns",
          "pov"
        ],
        "title": "CentipawnScore",
        "type": "object"
      },
      "EngineLine": {
        "additionalProperties": false,
        "properties": {
          "bounded": {
            "default": false,
            "title": "Bounded",
            "type": "boolean"
          },
          "depth": {
            "title": "Depth",
            "type": "integer"
          },
          "mover_score": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CentipawnScore"
              },
              {
                "$ref": "#/components/schemas/MateScore"
              }
            ],
            "title": "Mover Score"
          },
          "nodes": {
            "title": "Nodes",
            "type": "integer"
          },
          "pv": {
            "items": {
              "$ref": "#/components/schemas/VariationMove"
            },
            "title": "Pv",
            "type": "array"
          },
          "score": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CentipawnScore"
              },
              {
                "$ref": "#/components/schemas/MateScore"
              }
            ],
            "title": "Score"
          },
          "time_ms": {
            "title": "Time Ms",
            "type": "integer"
          },
          "wdl": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Wdl"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "score",
          "mover_score",
          "wdl",
          "depth",
          "nodes",
          "time_ms",
          "pv"
        ],
        "title": "EngineLine",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After Seconds"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GameResponse": {
        "additionalProperties": false,
        "properties": {
          "game": {
            "$ref": "#/components/schemas/GameSummary"
          },
          "initial_fen": {
            "title": "Initial Fen",
            "type": "string"
          },
          "pgn_hash": {
            "title": "Pgn Hash",
            "type": "string"
          },
          "positions": {
            "items": {
              "$ref": "#/components/schemas/PositionResponse"
            },
            "title": "Positions",
            "type": "array"
          },
          "result": {
            "enum": [
              "1-0",
              "0-1",
              "1/2-1/2"
            ],
            "title": "Result",
            "type": "string"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "game",
          "version",
          "pgn_hash",
          "initial_fen",
          "result",
          "positions"
        ],
        "title": "GameResponse",
        "type": "object"
      },
      "GameSummary": {
        "additionalProperties": false,
        "properties": {
          "black": {
            "$ref": "#/components/schemas/Player"
          },
          "eligibility": {
            "enum": [
              "available",
              "unsupported_game",
              "unfinished_game",
              "invalid_data",
              "game_too_large"
            ],
            "title": "Eligibility",
            "type": "string"
          },
          "end_time": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "rules": {
            "title": "Rules",
            "type": "string"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "time_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Class"
          },
          "white": {
            "$ref": "#/components/schemas/Player"
          }
        },
        "required": [
          "id",
          "source_url",
          "white",
          "black",
          "end_time",
          "time_class",
          "rules",
          "eligibility"
        ],
        "title": "GameSummary",
        "type": "object"
      },
      "GamesResponse": {
        "additionalProperties": false,
        "properties": {
          "fetched_at": {
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "games": {
            "items": {
              "$ref": "#/components/schemas/GameSummary"
            },
            "title": "Games",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          }
        },
        "required": [
          "fetched_at",
          "stale",
          "games",
          "next_cursor"
        ],
        "title": "GamesResponse",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ok",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JsonValue": {},
      "MateScore": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "mate",
            "default": "mate",
            "title": "Kind",
            "type": "string"
          },
          "moves": {
            "title": "Moves",
            "type": "integer"
          },
          "pov": {
            "enum": [
              "white",
              "black"
            ],
            "title": "Pov",
            "type": "string"
          }
        },
        "required": [
          "moves",
          "pov"
        ],
        "title": "MateScore",
        "type": "object"
      },
      "MoveEvidence": {
        "additionalProperties": false,
        "properties": {
          "automatic_reason_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Automatic Reason After"
          },
          "automatic_result_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Automatic Result After"
          },
          "before_ply": {
            "title": "Before Ply",
            "type": "integer"
          },
          "best": {
            "items": {
              "$ref": "#/components/schemas/EngineLine"
            },
            "title": "Best",
            "type": "array"
          },
          "claimable_draw_before": {
            "title": "Claimable Draw Before",
            "type": "boolean"
          },
          "expected_loss": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Loss"
          },
          "mover": {
            "enum": [
              "white",
              "black"
            ],
            "title": "Mover",
            "type": "string"
          },
          "played": {
            "$ref": "#/components/schemas/EngineLine"
          },
          "played_uci": {
            "title": "Played Uci",
            "type": "string"
          },
          "ply": {
            "title": "Ply",
            "type": "integer"
          },
          "root_fen": {
            "title": "Root Fen",
            "type": "string"
          },
          "status": {
            "enum": [
              "usable",
              "insufficient",
              "unstable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "ply",
          "before_ply",
          "root_fen",
          "mover",
          "played_uci",
          "best",
          "played",
          "status",
          "expected_loss",
          "claimable_draw_before",
          "automatic_result_after",
          "automatic_reason_after"
        ],
        "title": "MoveEvidence",
        "type": "object"
      },
      "Player": {
        "additionalProperties": false,
        "properties": {
          "rating": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "result": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "username": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "Player",
        "type": "object"
      },
      "PositionResponse": {
        "additionalProperties": false,
        "properties": {
          "fen": {
            "title": "Fen",
            "type": "string"
          },
          "ply": {
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Ply",
            "type": "integer"
          },
          "san": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "San"
          },
          "uci": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uci"
          }
        },
        "required": [
          "ply",
          "fen",
          "san",
          "uci"
        ],
        "title": "PositionResponse",
        "type": "object"
      },
      "VariationMove": {
        "additionalProperties": false,
        "properties": {
          "fen": {
            "title": "Fen",
            "type": "string"
          },
          "san": {
            "title": "San",
            "type": "string"
          },
          "uci": {
            "title": "Uci",
            "type": "string"
          }
        },
        "required": [
          "uci",
          "san",
          "fen"
        ],
        "title": "VariationMove",
        "type": "object"
      },
      "Wdl": {
        "additionalProperties": false,
        "properties": {
          "draws": {
            "title": "Draws",
            "type": "integer"
          },
          "losses": {
            "title": "Losses",
            "type": "integer"
          },
          "pov": {
            "enum": [
              "white",
              "black"
            ],
            "title": "Pov",
            "type": "string"
          },
          "wins": {
            "title": "Wins",
            "type": "integer"
          }
        },
        "required": [
          "wins",
          "draws",
          "losses",
          "pov"
        ],
        "title": "Wdl",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Chess Tutor API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/analyses": {
      "post": {
        "operationId": "create_analysis",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "OK"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Create"
      }
    },
    "/api/v1/analyses/{analysis_id}": {
      "get": {
        "operationId": "read_analysis",
        "parameters": [
          {
            "in": "path",
            "name": "analysis_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Analysis Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
