# Local development only. Compose binds its published ports to loopback.
CHESS_ENVIRONMENT=development
CHESS_DATABASE_URL=postgresql://chess:local-development@127.0.0.1:5433/chesstutor
CHESS_REDIS_URL=redis://127.0.0.1:6380/0
CHESS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Production requires a private stable signing key (at least 32 characters).
# CHESS_SESSION_SECRET=replace-with-your-private-random-signing-key
# Shared-network engine submissions per rolling hour; completed cache hits are free.
CHESS_ANALYSIS_IP_JOBS_PER_HOUR=20
# Required for live Chess.com lookup. Replace with your real operator contact.
# CHESS_PUBAPI_USER_AGENT=ChessTutor/0.1 (contact: https://your-project.example/contact)
